# =============================================================
# Speed-to-Lead configuration
# Copy to .env  (cp .env.example .env) and edit.
# The default values already run an offline demo with zero setup.
# =============================================================

# ---- CALL-E (required for real calls) ----
# Get from https://dashboard.heycall-e.com/account/api-keys
# Leave blank while CALLE_MODE=mock.
CALLE_API_KEY=

# Optional: override the CALL-E API endpoint (default is fine)
CALLE_BASE_URL=https://api.heycall-e.com

# ---- Mode ----
# "mock" -> offline deterministic qualification (no credits used)
# "live" -> place real outbound calls via CALL-E
CALLE_MODE=mock

# Max milliseconds to wait for a call's terminal result
CALL_TIMEOUT_MS=240000

# ---- Server ----
PORT=8787
HOST=0.0.0.0
# Optional: shared secret required on /api/lead-submit (blank = no auth)
WEBHOOK_SECRET=

# Company name the agent introduces itself as
COMPANY_NAME=Acme
# Timezone used when offering demo slots / booking
AGENT_TIMEZONE=America/Los_Angeles

# ---- Booking & Calendar ----
# "google" -> automatic Google Calendar API integration & collection
# "calcom" -> real Cal.com v2 API
# "mock"   -> offline demo
CALENDAR_PROVIDER=google

# Google Calendar Configuration (when CALENDAR_PROVIDER=google):
# Option A: Service Account (Recommended for headless servers)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_CALENDAR_ID=primary

# Option B: OAuth2 Refresh Token (Personal or Workspace account)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Option C: Google Apps Script Webhook (Zero GCP setup)
GOOGLE_CALENDAR_WEBHOOK_URL=

# Cal.com v2 API key (format: cal_live_...) when CALENDAR_PROVIDER=calcom
CALCOM_API_KEY=
CALCOM_EVENT_TYPE_ID=

# ---- Notifications & Multi-Channel Dispatch ----
# Slack Webhook for instant lead qualification alerts
SLACK_WEBHOOK_URL=

# Twilio (Real SMS dispatch with Google Calendar invite link)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ---- CRM ----
# "local" -> append JSONL to CRM_LOCAL_PATH (default)
# "hubspot" -> create a contact via the HubSpot v3 API
CRM_PROVIDER=local
# HubSpot private app access token (only when CRM_PROVIDER=hubspot)
HUBSPOT_ACCESS_TOKEN=
# Local JSON store directory (used when CRM_PROVIDER=local)
CRM_LOCAL_PATH=./data/leads.jsonl
# Durable idempotency ledger (replays of the same key return the stored outcome)
IDEMPOTENCY_PATH=./data/idempotency.json

