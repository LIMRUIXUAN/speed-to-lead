{
  "name": "speed-to-lead",
  "version": "0.1.0",
  "private": true,
  "description": "Sub-30s Speed-to-Lead inbound qualifier: webhook -> CALL-E outbound call -> BANT qualification -> calendar booking -> CRM write.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "test:mock": "tsx scripts/smoke.ts",
    "test:gcal": "tsx scripts/test-google-webhook.ts",
    "validate:live": "tsx scripts/live-smoke.ts",
    "validate:integrations": "tsx scripts/integrations-check.ts"
  },
  "dependencies": {
    "@call-e/calle": "^0.7.0",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=22"
  }
}
